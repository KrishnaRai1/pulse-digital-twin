# Copy to .env and adjust. Every backend setting is PULSE_<NAME> (see backend/app/config.py).

PULSE_ENV=dev
# SQLite by default. For TimescaleDB/PostgreSQL (untested path) use e.g.
# PULSE_DATABASE_URL=postgresql+psycopg://pulse:change-me@timescaledb:5432/pulse
# PULSE_DATABASE_URL=

# Require X-API-Key on every POST/PUT/DELETE. Leave empty for open demo mode; ALWAYS set in any shared deployment.
PULSE_API_KEY=

# advisory (operator approves each set-point) | closed_loop (policy-approved, still passes the safety layer)
PULSE_CONTROL_MODE=advisory

# Comma-separated browser origins allowed for CORS / WebSocket (add your Vercel URL in production)
PULSE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional regex for extra origins, e.g. Vercel preview URLs: https://pulse-[a-z0-9-]+\.vercel\.app
# PULSE_CORS_ORIGIN_REGEX=

# Field dataset (300-well Baghewala data in data/field): build the store in the background on start-up
PULSE_FIELD_AUTO_BUILD=true

# Built-in plant simulator stands in for SCADA/historian
PULSE_SIM_ENABLED=true
PULSE_SIM_TICK_SECONDS=2.0

# Optional Postgres container credentials (docker compose --profile timescale)
POSTGRES_PASSWORD=change-me
